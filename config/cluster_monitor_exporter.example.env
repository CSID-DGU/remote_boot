# Local Prometheus exporter settings.
# Copy this file per server and adjust SERVER_ID and REQUIRED_MOUNTS.

CLUSTER_MONITOR_EXPORTER_LISTEN_ADDR=":30074"
CLUSTER_MONITOR_EXPORTER_SERVER_ID=""

# Background collection interval. Prometheus scrapes read the latest cached result.
CLUSTER_MONITOR_EXPORTER_CHECK_INTERVAL="30s"
CLUSTER_MONITOR_EXPORTER_COMMAND_TIMEOUT="10s"
CLUSTER_MONITOR_EXPORTER_CONTAINER_CHECK_TIMEOUT="60s"
CLUSTER_MONITOR_EXPORTER_CONTAINER_CHECK_POLL="5s"

# Required mounts are comma-separated entries. Use source=target when the mount
# point is important, or just source when any mount point is acceptable.
# LAB example:
# CLUSTER_MONITOR_EXPORTER_REQUIRED_MOUNTS="100.100.100.100:/294t/dcloud/share=/home/tako7/share"
# FARM example:
# CLUSTER_MONITOR_EXPORTER_REQUIRED_MOUNTS="100.100.100.120:/volume1/share=/home/tako7/share"
CLUSTER_MONITOR_EXPORTER_REQUIRED_MOUNTS=""

CLUSTER_MONITOR_EXPORTER_HOST_GPU_CHECK_ENABLED=true
CLUSTER_MONITOR_EXPORTER_DOCKER_CHECK_ENABLED=true
CLUSTER_MONITOR_EXPORTER_CONTAINER_CHECKS_ENABLED=true
CLUSTER_MONITOR_EXPORTER_START_STOPPED_CONTAINERS=true
CLUSTER_MONITOR_EXPORTER_CONTAINER_SSH_RECOVERY_ENABLED=true

# Same default target image scope as the existing container monitor.
CLUSTER_MONITOR_EXPORTER_CONTAINER_IMAGE_REGEX="^(decs|dguailab/decs)(:|$)"

CLUSTER_MONITOR_EXPORTER_DOCKER_PATH="docker"
CLUSTER_MONITOR_EXPORTER_NVIDIA_SMI_PATH="nvidia-smi"
